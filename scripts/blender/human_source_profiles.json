{
  "$comment": [
    "Import profiles for external human bases. One entry per source tool.",
    "Nothing about a vendor is hard-coded in human_source_adapter.py -- it reads",
    "this file, so supporting a new source is a data change, not a code change.",
    "",
    "`bones` maps THIS PROJECT's rig names to the source's names. The first",
    "match wins, patterns are case-insensitive, and a bone with no match is",
    "reported rather than silently skipped: a missing pelvis has to be a loud",
    "failure, because everything downstream is measured from it.",
    "",
    "`drop_nodes` is matched against object names after import. External rigs",
    "routinely ship cameras, lights, IK controllers and helper empties that must",
    "not reach the GLB.",
    "",
    "`up_axis`/`forward_axis` describe what the SOURCE uses. The adapter converts",
    "to this project's contract: Babylon Y-up, forward +Z, feet on y=0."
  ],
  "profiles": {
    "generic-gltf": {
      "label": "Any glTF/GLB with a humanoid skeleton",
      "extension": [".glb", ".gltf"],
      "up_axis": "Y",
      "forward_axis": "+Z",
      "unit_scale": 1.0,
      "drop_nodes": ["^Camera", "^Light", "^Lamp", "_IK$", "^CTRL_", "^helper_"],
      "bones": {
        "root": ["root", "Root", "Armature"],
        "pelvis": ["pelvis", "Hips", "hip"],
        "spine": ["spine", "Spine", "Spine1"],
        "chest": ["chest", "Spine2", "Chest", "UpperChest"],
        "neck": ["neck", "Neck"],
        "head": ["head", "Head"],
        "upper_arm.L": ["upper_arm.L", "LeftArm", "arm_L", "upperarm_l"],
        "lower_arm.L": ["lower_arm.L", "LeftForeArm", "forearm_L", "lowerarm_l"],
        "hand.L": ["hand.L", "LeftHand", "hand_l"],
        "upper_arm.R": ["upper_arm.R", "RightArm", "arm_R", "upperarm_r"],
        "lower_arm.R": ["lower_arm.R", "RightForeArm", "forearm_R", "lowerarm_r"],
        "hand.R": ["hand.R", "RightHand", "hand_r"],
        "thigh.L": ["thigh.L", "LeftUpLeg", "upperleg_L", "thigh_l"],
        "shin.L": ["shin.L", "LeftLeg", "lowerleg_L", "calf_l"],
        "foot.L": ["foot.L", "LeftFoot", "foot_l"],
        "thigh.R": ["thigh.R", "RightUpLeg", "upperleg_R", "thigh_r"],
        "shin.R": ["shin.R", "RightLeg", "lowerleg_R", "calf_r"],
        "foot.R": ["foot.R", "RightFoot", "foot_r"]
      },
      "optional_bones": {
        "clavicle.L": ["clavicle.L", "LeftShoulder", "shoulder_L", "clavicle_l"],
        "clavicle.R": ["clavicle.R", "RightShoulder", "shoulder_R", "clavicle_r"],
        "thumb.L": ["thumb.L", "LeftHandThumb1", "thumb01_l"],
        "thumb.R": ["thumb.R", "RightHandThumb1", "thumb01_r"],
        "fingers.L": ["fingers.L", "LeftHandIndex1", "index01_l"],
        "fingers.R": ["fingers.R", "RightHandIndex1", "index01_r"],
        "toe.L": ["toe.L", "LeftToeBase", "ball_l"],
        "toe.R": ["toe.R", "RightToeBase", "ball_r"]
      }
    },
    "makehuman-fbx": {
      "label": "MakeHuman FBX export (CC0 output -- verify the licence text shipped with your build)",
      "extension": [".fbx"],
      "up_axis": "Y",
      "forward_axis": "-Z",
      "unit_scale": 1.0,
      "drop_nodes": ["^Camera", "^Light", "^Lamp"],
      "bones": {
        "root": ["Root", "root"],
        "pelvis": ["Hips", "pelvis"],
        "spine": ["Spine", "spine01"],
        "chest": ["Spine2", "Spine1", "spine03"],
        "neck": ["Neck", "neck01"],
        "head": ["Head", "head"],
        "upper_arm.L": ["LeftArm", "upperarm01.L"],
        "lower_arm.L": ["LeftForeArm", "lowerarm01.L"],
        "hand.L": ["LeftHand", "wrist.L"],
        "upper_arm.R": ["RightArm", "upperarm01.R"],
        "lower_arm.R": ["RightForeArm", "lowerarm01.R"],
        "hand.R": ["RightHand", "wrist.R"],
        "thigh.L": ["LeftUpLeg", "upperleg01.L"],
        "shin.L": ["LeftLeg", "lowerleg01.L"],
        "foot.L": ["LeftFoot", "foot.L"],
        "thigh.R": ["RightUpLeg", "upperleg01.R"],
        "shin.R": ["RightLeg", "lowerleg01.R"],
        "foot.R": ["RightFoot", "foot.R"]
      },
      "optional_bones": {
        "clavicle.L": ["LeftShoulder", "clavicle.L"],
        "clavicle.R": ["RightShoulder", "clavicle.R"],
        "thumb.L": ["LeftHandThumb1", "thumb01.L"],
        "thumb.R": ["RightHandThumb1", "thumb01.R"],
        "fingers.L": ["LeftHandIndex1", "finger2-1.L"],
        "fingers.R": ["RightHandIndex1", "finger2-1.R"],
        "toe.L": ["LeftToeBase", "toe1-1.L"],
        "toe.R": ["RightToeBase", "toe1-1.R"]
      }
    },
    "mixamo-fbx": {
      "label": "Mixamo / Character Creator style FBX (mixamorig: prefix)",
      "extension": [".fbx"],
      "up_axis": "Y",
      "forward_axis": "-Z",
      "unit_scale": 0.01,
      "strip_bone_prefix": ["mixamorig:", "mixamorig1:"],
      "drop_nodes": ["^Camera", "^Light", "^Lamp"],
      "bones": {
        "root": ["Hips"],
        "pelvis": ["Hips"],
        "spine": ["Spine"],
        "chest": ["Spine2", "Spine1"],
        "neck": ["Neck"],
        "head": ["Head"],
        "upper_arm.L": ["LeftArm"],
        "lower_arm.L": ["LeftForeArm"],
        "hand.L": ["LeftHand"],
        "upper_arm.R": ["RightArm"],
        "lower_arm.R": ["RightForeArm"],
        "hand.R": ["RightHand"],
        "thigh.L": ["LeftUpLeg"],
        "shin.L": ["LeftLeg"],
        "foot.L": ["LeftFoot"],
        "thigh.R": ["RightUpLeg"],
        "shin.R": ["RightLeg"],
        "foot.R": ["RightFoot"]
      },
      "optional_bones": {
        "clavicle.L": ["LeftShoulder"],
        "clavicle.R": ["RightShoulder"],
        "thumb.L": ["LeftHandThumb1"],
        "thumb.R": ["RightHandThumb1"],
        "fingers.L": ["LeftHandIndex1"],
        "fingers.R": ["RightHandIndex1"],
        "toe.L": ["LeftToeBase"],
        "toe.R": ["RightToeBase"]
      }
    }
  }
}

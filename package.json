{
  "name": "frostbound-expanse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Frostbound Expanse - a Babylon.js frost-themed territory expansion vertical slice",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "art:template": "node scripts/run-blender.mjs scripts/blender/create_template.py",
    "art:hero": "node scripts/run-blender.mjs scripts/blender/build_hero.py",
    "art:turret": "node scripts/run-blender.mjs scripts/blender/build_turret.py",
    "art:wall": "node scripts/run-blender.mjs scripts/blender/build_wall_gate.py",
    "art:units": "node scripts/run-blender.mjs scripts/blender/build_units.py",
    "art:buildings": "node scripts/run-blender.mjs scripts/blender/build_buildings.py",
    "art:resources": "node scripts/run-blender.mjs scripts/blender/build_resources.py",
    "art:export": "node scripts/run-blender.mjs scripts/blender/batch_export.py",
    "art:hero:review": "node scripts/capture-hero-review.mjs",
    "test:hero:runtime": "playwright test tests/hero-runtime.spec.ts",
    "art:validate": "node scripts/validate-models.mjs",
    "art:validate:hero": "node scripts/validate-hero-commercial.mjs",
    "ai:sync": "node scripts/generate-ai-sync.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.3",
    "@babylonjs/gui": "^7.54.3",
    "@babylonjs/loaders": "^7.54.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
